run = "cd backend && pip install -r requirements.txt && uvicorn app.main:app --host 0.0.0.0 --port 8080"
language = "python3"
entrypoint = "backend/app/main.py"

[nix]
channel = "stable-24_05"

[env]
DATABASE_URL = "sqlite:///./health_coach.db"

[deployment]
run = ["sh", "-c", "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8080"]
